# No imports of our own: the packed hw/init.rc already imports
# init.recovery.{logd,ldconfig,mksh,usb,service}.${ro.hardware}.rc, so a
# local import of usb.rc would be a duplicate and project.rc is not
# shipped by this tree (a dead import logs a warning every boot).

on early-init
    # Force TWRP onto the fbdev graphics backend (Round B screen fix).
    # The upstream (2025-01-30, "import layer topology support from CLO")
    # minuitwrp DRM backend is a Qualcomm port that splits the framebuffer
    # into DEFAULT_NUM_LMS=2 slices when the connector lacks the Qualcomm
    # "mode_properties" topology blob. This MTK MT6893 kernel exposes no
    # such blob (probed live: connector props are CRTC_ID only), so the DRM
    # path drives two 800px planes and only one slice reaches the panel —
    # the left-half-UI/right-half-black symptom. Blocking /dev/dri/card0
    # makes gr_init's open() fail and TWRP silently falls back to fbdev,
    # whose geometry is verified on-device (vi.bpp=32, red.offset=16 ->
    # BGRA canvas, 1600x2560, double buffered). This mkdir claims the node
    # path before ueventd's coldboot can create it (a directory makes node
    # creation fail permanently); if ueventd won that race, the wait+rm in
    # the on init section below removes the node instead. Both legs run
    # before the recovery service starts (on boot -> class_start default).
    mkdir /dev/dri
    mkdir /dev/dri/card0

    # MTK 显示空闲管理（mtk_drm_disp_idlemgr）：idletime 默认 50ms，面板
    # 无帧更新 50ms 即进入 idle（LFR/LP），本面板 idle 状态显示为白屏；
    # TWRP 启动时 splash 是静态帧、主题加载 2~3 秒无任何帧更新，正好
    # 整段白屏（Logo→白屏→首页）。阈值调到极大 = 实际禁用 idle。
    write /proc/displowpower/idletime 1000000000

on init
    # adb over USB, independent of the GUI. This kernel's legacy gadget
    # interface /sys/class/android_usb/android0 is config-less (state only:
    # no enable/functions/idVendor/f_ffs nodes), so configfs=0 leaves every
    # gadget write failing and USB never enumerated — that is how Round A's
    # adb died. USB on this kernel is configfs-only: the running system
    # keeps /config/usb_gadget/g1 bound to UDC usb0 and the stock recovery
    # ramdisk itself sets configfs=1 in this very section. Chain with
    # configfs=1: on fs mounts configfs + functionfs and builds g1 +
    # ffs.adb; ro.debuggable=1 (TWRP default.prop) sets sys.usb.config=adb
    # on fs, which starts adbd; adbd raises sys.usb.ffs.ready=1 and the hw
    # handler then links ffs.adb into configs/b.1 and writes
    # ${sys.usb.controller} into g1/UDC. Recovery has no USB HAL to set
    # that prop (the cmdline carries no androidboot.usb.controller), so set
    # it here: usb0 is the only UDC (verified via /sys/class/udc).
    # persist.* stays in RAM only: /data is not mounted at on init, so the
    # running system is not affected.
    setprop sys.usb.configfs 1
    setprop sys.usb.ffs.aio_compat 1
    setprop sys.usb.controller usb0
    setprop persist.sys.usb.config adb

    # Second leg of the fbdev force-out above: if the early-init mkdir
    # lost the race to ueventd, the char node exists here — remove it.
    # wait returns instantly when the path exists (dir or node); the 10s
    # timeout only elapses if the DRM device never appeared, in which case
    # the DRM backend would be skipped anyway.
    wait /dev/dri/card0 10
    rm /dev/dri/card0


on boot
    # Keymaster 4.1 for /data decryption (Round C). The service is the
    # byte-identical real vendor binary with its full readelf-verified
    # library closure under /system/lib64, declared as a VINTF fragment
    # at /vendor/etc/vintf/manifest so vold's libhidl client resolves
    # transport=hwbinder via hwservicemanager getTransport. It must
    # register before the recovery binary runs Decrypt_Data(): the /data
    # fstab entry carries the stock fileencryption= + keydirectory=
    # keywords and TWRP's vold waits for the keymaster HAL to unwrap
    # the metadata-encryption key. This imported on-boot action runs
    # before hw/init.rc's own on-boot class_start default, so the
    # service is up before the recovery binary starts. hwservicemanager
    # (started by its own rc at on init) is already running here. Flat
    # /system/bin rather than a hw/ subdirectory: this ramdisk's
    # ld.config.txt maps exactly dir.recovery = /system/bin into the
    # recovery linker namespace and that match is not recursive. The
    # vendor rc (class early_hal, user system drmrpc) is not reusable
    # verbatim: this recovery only starts the default class, and the
    # explicit-start + root pattern mirrors hwservicemanager itself.

    start keymaster-4-1

    # 双保险：early-init 若因节点未就绪未写入，这里补一次
    write /proc/displowpower/idletime 1000000000

    # keystore2 is where A12 vold actually performs its FBE/metadata key
    # operations (vold -> keystore2 -> keymaster; both hops block until
    # the service registers). TWRP's own keystore2.rc starts it at
    # late-init — start it again here (init ignores the duplicate) so it
    # is guaranteed up before the recovery binary reaches Decrypt_Data().
    start keystore2


on fs && property:ro.debuggable=0
    # distinguish USB shoulde connect or not, i.e. CDP vs SDP
    # set charging free due to it wait for USB activation

on post-fs
    # Support A/B feature for EMMC and UFS boot region
    symlink /dev/block/sda /dev/block/mmcblk0boot0
    symlink /dev/block/sdb /dev/block/mmcblk0boot1
    symlink /dev/block/mmcblk0boot0 /dev/block/platform/bootdevice/by-name/preloader_a
    symlink /dev/block/mmcblk0boot1 /dev/block/platform/bootdevice/by-name/preloader_b

    # Support A/B feature for combo emmc and ufs OTA update
    symlink /dev/block/platform/bootdevice/by-name/preloader_a /dev/block/platform/bootdevice/by-name/preloader_emmc_a
    symlink /dev/block/platform/bootdevice/by-name/preloader_b /dev/block/platform/bootdevice/by-name/preloader_emmc_b
    symlink /dev/block/platform/bootdevice/by-name/preloader_a /dev/block/platform/bootdevice/by-name/preloader_ufs_a
    symlink /dev/block/platform/bootdevice/by-name/preloader_b /dev/block/platform/bootdevice/by-name/preloader_ufs_b

    # Support A/B feature for combo emmc and ufs OTA update
    symlink /dev/block/platform/bootdevice/by-name/preloader_a /dev/block/by-name/preloader_emmc_a
    symlink /dev/block/platform/bootdevice/by-name/preloader_b /dev/block/by-name/preloader_emmc_b
    symlink /dev/block/platform/bootdevice/by-name/preloader_a /dev/block/by-name/preloader_ufs_a
    symlink /dev/block/platform/bootdevice/by-name/preloader_b /dev/block/by-name/preloader_ufs_b

    exec u:r:update_engine:s0 root root -- /system/bin/mtk_plpath_utils

    symlink /dev/block/mapper/pl_a /dev/block/by-name/preloader_raw_a
    symlink /dev/block/mapper/pl_b /dev/block/by-name/preloader_raw_b
    symlink /dev/block/mapper/pl_a /dev/block/platform/bootdevice/by-name/preloader_raw_a
    symlink /dev/block/mapper/pl_b /dev/block/platform/bootdevice/by-name/preloader_raw_b

service keymaster-4-1 /system/bin/android.hardware.keymaster@4.1-service
    user root
    group root
    disabled
    # Mandatory like every service in the packed ramdisk: without a
    # seclabel init refuses to start the service while SELinux is enabled
    # (even permissive). u:r:recovery:s0 is the domain the GUI binary and
    # the hwservicemanager/boot/health services already run under.
    seclabel u:r:recovery:s0

