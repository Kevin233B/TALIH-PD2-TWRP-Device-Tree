+					vold_ok = true;
+				} else {
+					LOGINFO("Decrypt_Data: metadata decryption call failed or was killed; continuing without decryption\n");
+					TWFunc::Exec_Cmd("/system/bin/sh /sbin/tw_kmsglog.sh dump", false);
+				}
+			} else {
+				LOGINFO("Decrypt_Data: fork failed (%d); continuing without decryption\n", errno);
+			}
