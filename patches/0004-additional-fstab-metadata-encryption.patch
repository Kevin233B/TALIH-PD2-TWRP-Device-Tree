+		if (TWFunc::Path_Exists("/etc/additional.fstab.src")) {
+			TWFunc::copy_file("/etc/additional.fstab.src", additional_fstab, 0600, false);
+			additional_ready = true;
+		}
+		if (additional_ready) {
