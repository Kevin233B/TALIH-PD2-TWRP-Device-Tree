 #endif
+				// TWRP recovery (ls12_mt8797): repair any f2fs inconsistency on the
+				// decrypted /data while it is still unmounted, before the filesystem
+				// gets mounted and written to. Without this, a dirty fs plus heavy
+				// writeback (e.g. the raw 'super' backup) triggers an f2fs
+				// 'access invalid blkaddr' storm and a kernel panic.
+				std::string crypto_dev = android::base::GetProperty("ro.crypto.fs_crypto_blkdev", "error");
+				if (TWFunc::Path_Exists("/system/bin/fsck.f2fs") && !crypto_dev.empty() && crypto_dev != "error") {
+					int fsck_ret = TWFunc::Exec_Cmd("/system/bin/fsck.f2fs -a " + crypto_dev, false);
+					LOGINFO("Decrypt_Data: fsck.f2fs -a %s -> %d\n", crypto_dev.c_str(), fsck_ret);
+				}
 				Decrypt_Data->Is_Decrypted = true;	// Needed to make the mount function work correctly
 				int retry_count = 10;
 				while (!Decrypt_Data->Mount(false) && --retry_count) usleep(500);
